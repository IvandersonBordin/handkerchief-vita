[Unit]
Description=Handkerchief PS Vita - uma issue aprovada por execução

[Service]
Type=oneshot
WorkingDirectory=%h/Projetos/handkerchief-vita
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/python3 %h/Projetos/handkerchief-vita/tools/issue_worker.py --run
TimeoutStartSec=50min

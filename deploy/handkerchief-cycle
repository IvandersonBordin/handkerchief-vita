#!/usr/bin/env bash
set -Eeuo pipefail

agent=${1:?Informe bruno ou carlos}
case "$agent" in bruno|carlos) ;; *) exit 2 ;; esac
state=${XDG_STATE_HOME:-$HOME/.local/state}/handkerchief
mkdir -p "$state"
exec 8>"$state/model.lock"
flock -sn 8 || exit 0
exec 9>"$state/$agent.lock"
flock -n 9 || exit 0
marker="$state/usage-limit"
if [[ -e "$marker" ]]; then
    echo "Ciclo em espera por cota. Consulte $marker."
    exit 0
fi

worktree="$HOME/Projetos/handkerchief-vita-$agent"
schedule="$state/$agent.schedule"
mode=normal
due=0
if [[ -f "$schedule" ]]; then
    read -r mode due < "$schedule"
fi
head=$(git -C "$worktree" rev-parse HEAD)
approved="$state/$agent.approved"
handoff=""
if [[ -s "$approved" ]]; then
    { read -r reviewed; IFS= read -r handoff; } < "$approved"
    if [[ "$reviewed" != "$head" || "$mode" != espera ]]; then
        echo "Aprovação obsoleta para $agent." >&2
        mv "$approved" "$approved.stale"
        exit 0
    fi
    mv "$approved" "$approved.consumed"
    mode=normal
    due=0
fi
if [[ "$mode" == espera ]] || (( $(date +%s) < due )); then
    exit 0
fi

set_schedule() {
    printf '%s %s\n' "$1" "$2" > "$schedule.tmp"
    mv "$schedule.tmp" "$schedule"
}

# Se houver interrupção ou erro parcial, a próxima sondagem aguarda revisão.
set_schedule espera 0
phase=inicio
trap 'echo "Falha em $phase (linha $LINENO, código $?). $agent em espera para revisão." >&2' ERR
before=$(git -C "$worktree" rev-parse HEAD)
decision=$(mktemp "$state/$agent.decision.XXXXXX")
trap 'unlink "$decision"' EXIT
export HANDKERCHIEF_CYCLE_HINT="Encerre a resposta com uma linha CONTINUAR: seguida da próxima ação concreta já autorizada, ou AGUARDAR: seguida do bloqueio ou conclusão. Só peça continuação se a tarefa puder avançar agora."
export HANDKERCHIEF_CYCLE_HINT="$HANDKERCHIEF_CYCLE_HINT
Continuação aprovada para este commit: $handoff"
phase=agente
agent_status=0
{
    "$HOME/.local/bin/handkerchief-agent" "$agent" |
        while IFS= read -r line || [[ -n "$line" ]]; do
            printf '%s\n' "$line"
            # Codex escreve a resposta final em stdout e a transcrição em stderr.
            # O launcher acrescenta seu rodapé e a data após a resposta.
            if [[ "$line" == "=== FINALIZADO $agent ===" ]]; then
                cat
                break
            fi
            case "$line" in
                "CONTINUAR: "?*|"AGUARDAR: "?*) printf '%s\n' "$line" > "$decision" ;;
                ?*) : > "$decision" ;;
            esac
        done
} 2>&1 |
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "${line,,}" in
            error:*usage\ limit*|error:*usage_limit_reached*|error:*out\ of\ codex\ messages*)
                printf '%s\n' "$line" > "$marker"
                ;;
        esac
        printf '%s\n' "$line"
    done || agent_status=$?
if [[ -e "$marker" ]]; then
    # A liberação manual do marcador compartilhado deve permitir retomar.
    if [[ -n "$handoff" ]]; then
        mv "$approved.consumed" "$approved"
    else
        set_schedule normal 0
    fi
    exit 0
fi
if (( agent_status != 0 )); then
    echo "Falha em $phase (código $agent_status). $agent em espera para revisão." >&2
    exit "$agent_status"
fi

phase=verificacao
changes=$(git -C "$worktree" status --porcelain --untracked-files=all -- . ':(exclude)docs/agent-progress.md')
if [[ -z "$changes" ]]; then
    echo "Sem alteração além do diário. Trabalho preservado localmente; $agent em espera."
    exit 0
fi
phase=publicacao
"$HOME/.local/bin/handkerchief-publish" "$agent"
after=$(git -C "$worktree" rev-parse HEAD)
next=$(cat "$decision")
if [[ "$before" != "$after" && "$next" == "CONTINUAR: "?* ]]; then
    printf '%s\n%s\n' "$after" "${next#CONTINUAR: }" > "$state/$agent.pending.tmp"
    mv "$state/$agent.pending.tmp" "$state/$agent.pending"
fi
